<Project Sdk="Microsoft.NET.Sdk.Web">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <RootNamespace>Alquiler_Vehiculos</RootNamespace>
        <UserSecretsId>alquiler-vehiculos-back-local</UserSecretsId>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="CSharpFunctionalExtensions" Version="3.7.0" />
        <PackageReference Include="FluentValidation" Version="12.2.0" />
        <PackageReference Include="FluentValidation.DependencyInjectionExtensions" Version="12.2.0" />
        <PackageReference Include="MailKit" Version="4.18.2" />
        <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.0" />
        <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.0" />
        <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.15" />
        <PackageReference Include="Microsoft.OpenApi" Version="2.13.0" />
        <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.8" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.8" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.8">
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
        <PackageReference Include="Microsoft.IdentityModel.Tokens" Version="8.23.0" />
        <PackageReference Include="MongoDB.EntityFrameworkCore" Version="10.0.2" />
        <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.2" />
        <PackageReference Include="Serilog" Version="4.4.0" />
        <PackageReference Include="StackExchange.Redis" Version="3.4.35" />
        <PackageReference Include="Serilog.AspNetCore" Version="8.0.3" />
        <PackageReference Include="Serilog.Sinks.Console" Version="6.0.0" />
        <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
    </ItemGroup>

    <ItemGroup>
        <Content Update="Templates\Email\**" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

    <ItemGroup>
        <Folder Include="Controllers\Pago\" />
        <Folder Include="Controllers\Reserva\" />
        <Folder Include="Data\Seed\Storage\" />
        <Folder Include="Data\Seed\Vehiculo\" />
        <Folder Include="Errors\Cliente\" />
        <Folder Include="Errors\Pago\" />
        <Folder Include="Errors\Reserva\" />
        <Folder Include="Errors\Trabajador\" />
        <Folder Include="Exceptions\Cliente\" />
        <Folder Include="Exceptions\Pago\" />
        <Folder Include="Exceptions\Reserva\" />
        <Folder Include="Exceptions\Trabajador\" />
        <Folder Include="Exceptions\Vehiculo\" />
        <Folder Include="Middleware\" />
        <Folder Include="Models\Pago\" />
        <Folder Include="Models\Reserva\" />
        <Folder Include="Repositories\Cliente\" />
        <Folder Include="Repositories\Reserva\" />
        <Folder Include="Services\Cliente\" />
        <Folder Include="Services\Pago\" />
        <Folder Include="Services\Reserva\" />
        <Folder Include="Services\Trabajador\" />
        <Folder Include="Services\Vehiculo\Marca\" />
    </ItemGroup>
</Project>
