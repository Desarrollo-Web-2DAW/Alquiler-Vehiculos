<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <RootNamespace>Alquiler_Vehiculos</RootNamespace>
        <UserSecretsId>alquiler-vehiculos-2daw-2026</UserSecretsId>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="CSharpFunctionalExtensions" Version="3.7.0"/>
        <PackageReference Include="FluentValidation.AspNetCore" Version="11.3.1"/>
        <PackageReference Include="MailKit" Version="4.18.2"/>
        <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.4"/>
        <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.4"/>
        <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.15"/>
        <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.4">
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
        <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3"/>
        <PackageReference Include="Serilog" Version="4.4.0"/>
        <PackageReference Include="Serilog.AspNetCore" Version="10.0.0"/>
        <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1"/>
        <PackageReference Include="Serilog.Sinks.File" Version="7.0.0"/>
        <PackageReference Include="StackExchange.Redis" Version="3.4.35"/>
    </ItemGroup>

    <ItemGroup>
      <!-- Plantillas de correo: se copian a la salida para poder renderizarlas en tiempo de ejecución -->
      <Content Update="Templates\Email\**" CopyToOutputDirectory="PreserveNewest"/>
    </ItemGroup>

    <ItemGroup>
        <Folder Include="Controllers\Pago\"/>
        <Folder Include="Controllers\Reserva\"/>
        <Folder Include="Controllers\Vehiculo\"/>
        <Folder Include="Errors\Vehiculo\"/>
        <Folder Include="Exceptions\Cliente\"/>
        <Folder Include="Exceptions\Pago\"/>
        <Folder Include="Exceptions\Reserva\"/>
        <Folder Include="Exceptions\Trabajador\"/>
        <Folder Include="Exceptions\Vehiculo\"/>
        <Folder Include="Mappers\"/>
        <Folder Include="Middleware\"/>
        <Folder Include="Models\Pago\"/>
        <Folder Include="Models\Reserva\"/>
        <Folder Include="Models\Vehiculo\"/>
        <Folder Include="Repositories\Cliente\"/>
        <Folder Include="Repositories\Reserva\"/>
        <Folder Include="Repositories\Vehiculo\"/>
        <Folder Include="Services\Vehiculo\"/>
    </ItemGroup>

</Project>
