{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Email": {
    // Envío real con la cuenta del proyecto (Gmail con contraseña de aplicación).
    // La contraseña NO va en el repositorio: user-secrets en desarrollo
    // y variable de entorno Email__Password en producción (RNF-03).
    "Host": "smtp.gmail.com",
    "Port": 587,
    "Username": "funkopopapi@gmail.com",
    "Password": "",
    "From": "funkopopapi@gmail.com",
    "FromName": "Alquiler Vehículos",
    "Security": "Tls",
    "UseSmtp": true,
    "MaxIntentos": 5,
    "IntervaloBaseReintentosSegundos": 30,
    "FrecuenciaProcesoSegundos": 10,
    "LoteMaximo": 20
  },
  "Cache": {
    "Capacity": 500,
    "SlidingExpirationSeconds": 60,
    "AbsoluteMaxLifetimeSeconds": 600,
    "PruneIntervalSeconds": 60
  },
  "Redis": {
    "ConnectionString": "localhost:6379"
  },
  "Jwt": {
    // La clave secreta NO va en el repositorio (RNF-03):
    // User Secrets en desarrollo y variable de entorno Jwt__Key en producción.
    "Key": "",
    "Issuer": "Alquiler-Vehiculos",
    "Audience": "Alquiler-Vehiculos-Users",
    "ExpirationMinutes": 30
  },
  "Api": {
    "Nombre": "Alquiler-Vehiculos API",
    "Mensaje": "Modo base"
  }
}
