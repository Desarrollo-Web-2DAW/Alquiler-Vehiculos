{
  "ConnectionStrings": {
    "Catalogo": ""
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Jwt": {
    "Issuer": "Alquiler-Vehiculos",
    "Audience": "Alquiler-Vehiculos-Users",
    "ExpirationMinutes": 30
  },
  "Api": {
    "Nombre": "Alquiler-Vehiculos API",
    "Mensaje": "Modo base"
  },
  "Email": {
    "Host": "smtp.gmail.com",
    "Port": 587,
    "Username": "funkopopapi@gmail.com",
    "From": "funkopopapi@gmail.com",
    "FromName": "Alquiler Vehículos",
    "Security": "Tls",
    "UseSmtp": true,
    "MaxIntentos": 5,
    "IntervaloBaseReintentosSegundos": 30,
    "FrecuenciaProcesoSegundos": 10,
    "LoteMaximo": 20
  },
  "Cache": {
    "Capacity": 500,
    "SlidingExpirationSeconds": 60,
    "AbsoluteMaxLifetimeSeconds": 600,
    "PruneIntervalSeconds": 60
  },
  "Redis": {
    "ConnectionString": "localhost:6379"
  },
  "Storage": {
    "UploadPath": "uploads",
    "MaxFileSize": "5242880",
    "AllowedExtensions": [ ".jpg", ".jpeg", ".png", ".gif" ],
    "AllowedContentTypes": [ "image/jpeg", "image/png", "image/gif" ],
    "Folders": {
      "Vehiculos": "vehiculos"
    }
  },
  "AllowedHosts": "*"
}
