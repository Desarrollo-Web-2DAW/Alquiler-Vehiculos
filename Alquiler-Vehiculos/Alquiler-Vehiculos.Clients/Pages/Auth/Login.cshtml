@page
@model LoginModel

@{
    ViewData["Title"] = "Iniciar sesión";
}

<div class="row justify-content-center">
    <div class="col-md-5">
        <h1 class="text-center mb-4">Iniciar sesión</h1>
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            <div class="mb-3">
                <label asp-for="LoginRequest.Email" class="form-label">Correo electrónico</label>
                <input asp-for="LoginRequest.Email" class="form-control" type="email"/>
                <span asp-validation-for="LoginRequest.Email" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="LoginRequest.Password" class="form-label">Contraseña</label>
                <input asp-for="LoginRequest.Password" class="form-control" type="password"/>
                <span asp-validation-for="LoginRequest.Password" class="text-danger"></span>
            </div>
            @if (!string.IsNullOrEmpty(Model.ErrorMessage)) {
                <div class="alert alert-danger">
                    @Model.ErrorMessage
                </div>
            }
            <button type="submit" class="btn btn-primary w-100">
                Entrar
            </button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial"/>
}