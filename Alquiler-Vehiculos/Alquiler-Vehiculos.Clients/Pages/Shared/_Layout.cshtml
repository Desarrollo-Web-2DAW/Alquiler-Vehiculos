<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>@ViewData["Title"] - MotorHub</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css"/>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/>
    @await RenderSectionAsync("Styles", false)
</head>
<body>
<header class="site-header">
    <nav class="navbar navbar-expand-sm">
        <div class="container">
            <a class="navbar-brand brand-lockup" asp-area="" asp-page="/Index">
                <span class="brand-symbol" aria-hidden="true">M</span>
                <span>MOTOR<span class="brand-accent">HUB</span><small>ALQUILER · TALLER</small></span>
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavigation"
                    aria-controls="mainNavigation" aria-expanded="false" aria-label="Abrir navegación">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="mainNavigation">
                <ul class="navbar-nav ms-auto align-items-sm-center">
                    @if (User.Identity?.IsAuthenticated == true &&
                         (User.IsInRole("Trabajador") || User.IsInRole("Responsable") || User.IsInRole("Admin"))) {
                        <li class="nav-item">
                            <a class="nav-link nav-link-active" asp-area="" asp-page="/Notificaciones">Notificaciones</a>
                        </li>
                        <li class="nav-item ms-sm-3">
                            <form method="post" asp-page="/Index" asp-page-handler="Logout">
                                <button type="submit" class="btn btn-nav-logout">Cerrar sesión</button>
                            </form>
                        </li>
                    } else {
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-page="/Index">Inicio</a>
                        </li>
                        <li class="nav-item ms-sm-3">
                            <a class="btn btn-nav-login" asp-area="" asp-page="/Auth/Login">Iniciar sesión</a>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </nav>
</header>

<main role="main">
    @RenderBody()
</main>

<footer class="site-footer">
    <div class="container d-flex justify-content-between align-items-center flex-wrap gap-2">
        <span>© 2026 MOTORHUB</span>
        <span>GESTIÓN DE ALQUILER Y MANTENIMIENTO DE VEHÍCULOS</span>
    </div>
</footer>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", false)
</body>
</html>
