<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.0" />
        <PackageReference Include="NUnit" Version="4.3.2" />
        <PackageReference Include="NUnit3TestAdapter" Version="5.0.0" />
        <PackageReference Include="FluentAssertions" Version="8.11.0" />
        <PackageReference Include="Moq" Version="4.20.72" />
        <PackageReference Include="coverlet.collector" Version="10.1.1" GeneratePathProperty="true" />
        <Using Include="NUnit.Framework" />
        <None Update="storage.runsettings" CopyToOutputDirectory="PreserveNewest" />
        <ProjectReference Include="../Alquiler-Vehiculos.Back/Alquiler-Vehiculos.Back.csproj" />
    </ItemGroup>
    <Target Name="CopyContainerCoverageCollector" AfterTargets="Build">
        <ItemGroup>
            <CoverageFiles Include="$(Pkgcoverlet_collector)/build/net10.0/**/*" />
        </ItemGroup>
        <Copy SourceFiles="@(CoverageFiles)"
              DestinationFiles="@(CoverageFiles->'$(OutDir)Collector/%(RecursiveDir)%(Filename)%(Extension)')"
              SkipUnchangedFiles="true" />
    </Target>
</Project>
