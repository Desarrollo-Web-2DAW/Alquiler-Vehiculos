meta {
  name: [095] MARCAS - Modificar como Trabajador (403)
  type: http
  seq: 5
}

put {
  url: {{baseUrl}}/api/marca/{{marcaE2EId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{trabajadorToken}}
}

body:json {
  { "nombre": "Cambio prohibido E2E", "pais": "España", "web": "https://marca.example", "modelosDisponibles": ["Modelo prohibido"] }
}

tests {
  // Assert
  test("RF-46: Trabajador no modifica marcas", function () {
    expect(res.getStatus()).to.equal(403);
  });
}
