meta {
  name: [104] MARCAS - Listar sin la marca retirada (200)
  type: http
  seq: 14
}

get {
  url: {{baseUrl}}/api/marca
  body: none
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

tests {
  // Assert
  test("RF-09: el listado habitual excluye la marca de baja", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody()).to.be.an("array");
    expect(res.getBody().some(m => m.id === bru.getVar("marcaE2EId"))).to.equal(false);
  });
}
