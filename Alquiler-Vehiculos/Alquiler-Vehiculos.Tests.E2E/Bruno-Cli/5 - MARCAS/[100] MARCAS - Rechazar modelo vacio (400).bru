meta {
  name: [100] MARCAS - Rechazar modelo vacio (400)
  type: http
  seq: 10
}

put {
  url: {{baseUrl}}/api/marca/{{marcaE2EId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

body:json {
  { "nombre": "No debe guardarse", "pais": "España", "web": "https://marca.example", "modelosDisponibles": ["   "] }
}

tests {
  // Assert
  test("Validación del modelo concreto, no un 400 por otro motivo", function () {
    expect(res.getStatus()).to.equal(400);
    expect(res.getBody().details["ModelosDisponibles[0]"]).to.be.an("array").that.is.not.empty;
  });
}
