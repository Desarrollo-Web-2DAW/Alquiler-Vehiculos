meta {
  name: [014] USERS - Listar como Trabajador (403)
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/users
  body: none
  auth: bearer
}

auth:bearer {
  token: {{trabajadorToken}}
}

script:post-response {
  test("Users como Trabajador - Status 403 Forbidden", function () {
    expect(res.getStatus()).to.equal(403);
  });
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  RF-46: un Trabajador autenticado no tiene permiso Admin sobre /api/users.
}
