meta {
  name: [003] SIGNUP - Error email duplicado (409)
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/auth/signup
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "{{nuevoClienteEmail}}",
    "password": "Password123!",
    "nombre": "Luis",
    "apellidos": "Duplicado",
    "telefono": "655443399",
    "fechaNacimiento": "1996-08-20",
    "dni": "56789012B"
  }
}

script:post-response {
  test("Signup email duplicado - Status 409 Conflict", function () {
    expect(res.getStatus()).to.equal(409);
  });

  test("Signup email duplicado - Devuelve código EMAIL_DUPLICADO", function () {
    const body = res.getBody();
    expect(body.code).to.equal("EMAIL_DUPLICADO");
  });
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  Un email ya registrado se rechaza con 409 Conflict.
}
