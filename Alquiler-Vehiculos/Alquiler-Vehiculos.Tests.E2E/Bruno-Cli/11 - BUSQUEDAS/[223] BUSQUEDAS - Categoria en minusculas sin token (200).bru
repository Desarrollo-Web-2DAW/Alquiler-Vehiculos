meta {
  name: [223] BUSQUEDAS - Categoria en minusculas sin token (200)
  type: http
  seq: 23
}

get {
  url: {{baseUrl}}/api/vehiculo/search?marca={{bqMarca}}&categoria=suv
  body: none
  auth: none
}

tests {
  test("RF-06: recuento exacto (Categoria en minusculas)", function () {
    expect(res.getStatus()).to.equal(200);
    const grupos = res.getBody();
    expect(grupos).to.be.an("array");
    grupos.forEach(g => expect(g.marca).to.equal(bru.getVar("bqMarca")));
    const firma = g => [g.modelo, g.categoria, g.unidadesTotales, g.unidadesLibres].join("|");
    const esperado = [
      [bru.getVar("bqBeta"), "Suv", 2, 2]
    ].map(e => e.join("|")).sort();
    expect(grupos.map(firma).sort()).to.deep.equal(esperado);
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
