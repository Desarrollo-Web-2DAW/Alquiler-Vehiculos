meta {
  name: [218] BUSQUEDAS - Modelo sin marca en minusculas como Admin (200)
  type: http
  seq: 18
}

get {
  url: {{baseUrl}}/api/vehiculo/search?modelo={{bqAlfaMinusculas}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

script:pre-request {
  bru.setVar("bqAlfaMinusculas", bru.getVar("bqAlfa").toLowerCase());
}

tests {
  test("RF-06: el filtro de modelo funciona solo", function () {
    expect(res.getStatus()).to.equal(200);
    const grupos = res.getBody();
    expect(grupos).to.be.an("array");
    grupos.forEach(g => expect(g.marca).to.equal(bru.getVar("bqMarca")));
    const firma = g => [g.modelo, g.categoria, g.unidadesTotales, g.unidadesLibres].join("|");
    const esperado = [
      [bru.getVar("bqAlfa"), "Hatchback", 3, 2]
    ].map(e => e.join("|")).sort();
    expect(grupos.map(firma).sort()).to.deep.equal(esperado);
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
