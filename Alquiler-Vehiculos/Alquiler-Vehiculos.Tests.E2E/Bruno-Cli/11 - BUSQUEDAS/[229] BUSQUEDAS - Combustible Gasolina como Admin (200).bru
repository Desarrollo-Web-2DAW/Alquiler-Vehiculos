meta {
  name: [229] BUSQUEDAS - Combustible Gasolina como Admin (200)
  type: http
  seq: 29
}

get {
  url: {{baseUrl}}/api/vehiculo/search?marca={{bqMarca}}&combustible=Gasolina
  body: none
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

tests {
  test("RF-06: recuento exacto (Combustible Gasolina)", function () {
    expect(res.getStatus()).to.equal(200);
    const grupos = res.getBody();
    expect(grupos).to.be.an("array");
    grupos.forEach(g => expect(g.marca).to.equal(bru.getVar("bqMarca")));
    const firma = g => [g.modelo, g.categoria, g.unidadesTotales, g.unidadesLibres].join("|");
    const esperado = [
      [bru.getVar("bqAlfa"), "Hatchback", 1, 1]
    ].map(e => e.join("|")).sort();
    expect(grupos.map(firma).sort()).to.deep.equal(esperado);
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
