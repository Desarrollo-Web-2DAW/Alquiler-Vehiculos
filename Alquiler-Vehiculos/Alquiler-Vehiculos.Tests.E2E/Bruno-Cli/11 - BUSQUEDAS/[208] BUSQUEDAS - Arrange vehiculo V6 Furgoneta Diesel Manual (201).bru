meta {
  name: [208] BUSQUEDAS - Arrange vehiculo V6 Furgoneta Diesel Manual (201)
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/api/vehiculo
  body: multipartForm
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

body:multipart-form {
  foto: @file(fixtures/vehiculo.jpg)
  matricula: {{bqMatV6}}
  marca: {{bqMarca}}
  modelo: {{bqGamma}}
  acriss: FKMD
  color: Blanco
  precioBaseDia: 50
  plazas: 3
  maleteroLitros: 5000
  autonomiaKm: 800
  kilometraje: 1000
  fechaUltimaRevision: 2026-01-15
  concesionario: {{bqConcesionarioId}}
}

script:pre-request {
  // Arrange: matrícula aleatoria distinta de las ya generadas en esta ejecución.
  const letras = "BCDFGHJKLMNPRSTVWXYZ";
  const usadas = ["V1", "V2", "V3", "V4", "V5", "V6"].map(v => bru.getVar(`bqMat${v}`));
  let matricula;
  do {
    const numero = String(Math.floor(Math.random() * 10000)).padStart(4, "0");
    matricula = numero + Array.from({ length: 3 }, () => letras[Math.floor(Math.random() * letras.length)]).join("");
  } while (usadas.includes(matricula));
  bru.setVar("bqMatV6", matricula);
}

tests {
  test("Arrange: V6 clasificado como Furgoneta/Diesel/Manual", function () {
    expect(res.getStatus()).to.equal(201);
    const v = res.getBody();
    expect(v.estado).to.equal("Disponible");
    expect(v.categoria).to.equal("Furgoneta");
    expect(v.combustible).to.equal("Diesel");
    expect(v.transmision).to.equal("Manual");
  });
  if (res.getStatus() === 201) bru.setVar("bqV6Id", res.getBody().id);
}

settings {
  encodeUrl: true
  timeout: 0
}
