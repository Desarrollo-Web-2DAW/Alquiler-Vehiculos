meta {
  name: [243] BUSQUEDAS - Combustible invalido (400)
  type: http
  seq: 43
}

get {
  url: {{baseUrl}}/api/vehiculo/search?combustible=Gasoil
  body: none
  auth: none
}

tests {
  test("Filtro Combustible rechazado con su campo, no un 400 por otro motivo", function () {
    expect(res.getStatus()).to.equal(400);
    expect(res.getBody().code).to.equal("VALIDACION");
    expect(res.getBody().details["Combustible"]).to.be.an("array").that.is.not.empty;
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
