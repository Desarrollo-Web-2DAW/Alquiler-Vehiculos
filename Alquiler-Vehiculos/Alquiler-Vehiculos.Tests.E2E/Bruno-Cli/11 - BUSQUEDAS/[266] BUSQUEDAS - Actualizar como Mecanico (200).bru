meta {
  name: [266] BUSQUEDAS - Actualizar como Mecanico (200)
  type: http
  seq: 66
}

put {
  url: {{baseUrl}}/api/vehiculo/{{bqV1Id}}
  body: multipartForm
  auth: bearer
}

auth:bearer {
  token: {{mecanicoToken}}
}

body:multipart-form {
  foto: @file(fixtures/vehiculo.jpg)
  matricula: {{bqMatV1}}
  marca: {{bqMarca}}
  modelo: {{bqAlfa}}
  acriss: CDMD
  color: Naranja
  precioBaseDia: 50
  plazas: 5
  maleteroLitros: 380
  autonomiaKm: 1000
  kilometraje: 1000
  fechaUltimaRevision: 2026-01-15
  concesionario: {{bqConcesionarioId}}
}

tests {
  test("RF-46: Mecanico modifica datos sin cambiar estado ni baja", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().color).to.equal("Naranja");
    expect(res.getBody().estado).to.equal("Disponible");
    expect(res.getBody().isActivo).to.equal(true);
  });
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  El mecánico tiene rol Trabajador y la política Trabajador le permite modificar.
  Decisión vigente del proyecto; revisar si RF-46 debe restringirlo.
}
