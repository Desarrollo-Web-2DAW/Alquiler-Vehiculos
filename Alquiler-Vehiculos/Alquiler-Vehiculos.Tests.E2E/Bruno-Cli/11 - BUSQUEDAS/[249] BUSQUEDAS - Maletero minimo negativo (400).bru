meta {
  name: [249] BUSQUEDAS - Maletero minimo negativo (400)
  type: http
  seq: 49
}

get {
  url: {{baseUrl}}/api/vehiculo/search?maleteroLitrosMinimos=-1
  body: none
  auth: none
}

tests {
  test("Filtro MaleteroLitrosMinimos rechazado con su campo, no un 400 por otro motivo", function () {
    expect(res.getStatus()).to.equal(400);
    expect(res.getBody().code).to.equal("VALIDACION");
    expect(res.getBody().details["MaleteroLitrosMinimos"]).to.be.an("array").that.is.not.empty;
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
