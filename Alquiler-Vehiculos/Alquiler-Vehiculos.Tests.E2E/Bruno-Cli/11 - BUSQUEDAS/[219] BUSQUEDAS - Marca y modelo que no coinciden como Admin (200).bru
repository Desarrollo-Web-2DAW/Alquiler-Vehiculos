meta {
  name: [219] BUSQUEDAS - Marca y modelo que no coinciden como Admin (200)
  type: http
  seq: 19
}

get {
  url: {{baseUrl}}/api/vehiculo/search?marca={{bqMarca}}&modelo=NoExiste
  body: none
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

tests {
  test("RF-06: recuento exacto (Marca y modelo que no coinciden)", function () {
    expect(res.getStatus()).to.equal(200);
    const grupos = res.getBody();
    expect(grupos).to.be.an("array");
    grupos.forEach(g => expect(g.marca).to.equal(bru.getVar("bqMarca")));
    const firma = g => [g.modelo, g.categoria, g.unidadesTotales, g.unidadesLibres].join("|");
    const esperado = [
      
    ].map(e => e.join("|")).sort();
    expect(grupos.map(firma).sort()).to.deep.equal(esperado);
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
