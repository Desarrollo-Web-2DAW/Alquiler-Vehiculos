meta {
  name: [245] BUSQUEDAS - Estado invalido (400)
  type: http
  seq: 45
}

get {
  url: {{baseUrl}}/api/vehiculo/search?estado=Averiado
  body: none
  auth: none
}

tests {
  test("Filtro Estado rechazado con su campo, no un 400 por otro motivo", function () {
    expect(res.getStatus()).to.equal(400);
    expect(res.getBody().code).to.equal("VALIDACION");
    expect(res.getBody().details["Estado"]).to.be.an("array").that.is.not.empty;
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
