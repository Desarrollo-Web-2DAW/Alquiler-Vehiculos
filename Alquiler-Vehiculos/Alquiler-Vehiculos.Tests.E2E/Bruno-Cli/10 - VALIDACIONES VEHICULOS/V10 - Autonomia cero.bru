meta {
  name: V10 - Autonomia cero
  type: http
  seq: 10
}
put {
  url: {{baseUrl}}/api/vehiculo/{{vehiculoValidacionId}}
  body: multipartForm
  auth: bearer
}
auth:bearer {
  token: {{trabajadorToken}}
}
body:multipart-form {
  foto: @file(fixtures/vehiculo.jpg)
  matricula: {{matriculaValidacion}}
  marca: {{marcaValidacion}}
  modelo: Modelo validacion
  acriss: ILAH
  color: Negro
  precioBaseDia: 55
  plazas: 5
  maleteroLitros: 470
  autonomiaKm: 0
  kilometraje: 1500
  fechaUltimaRevision: 2026-01-15
  concesionario: {{concesionarioValidacionId}}
}
tests {
  // Assert
  test("Autonomía cero rechazada por AutonomiaKm", function () {
    expect(res.getStatus()).to.equal(400);
    expect(res.getBody().details.AutonomiaKm).to.include("La autonomía en kilómetros debe ser mayor que cero.");
  });
}
