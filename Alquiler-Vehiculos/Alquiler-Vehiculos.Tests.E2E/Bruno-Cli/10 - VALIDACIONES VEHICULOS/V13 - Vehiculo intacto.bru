tests {
  // Assert
  test("Los PUT rechazados conservan todos los datos y la foto anterior", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody()).to.deep.equal(bru.getVar("vehiculoValidacionOriginal"));
  });
}
