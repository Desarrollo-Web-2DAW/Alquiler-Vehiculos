meta {
  name: V02 - Crear concesionario
  type: http
  seq: 2
}
post {
  url: {{baseUrl}}/api/concesionario
  body: json
  auth: bearer
}
auth:bearer {
  token: {{adminToken}}
}
body:json {
  { "nombre": "{{marcaValidacion}} concesionario", "ciudad": "Leganés", "telefono": "{{telefonoValidacion}}", "email": "validacion@concesionario.example" }
}
tests {
  // Assert
  test("Concesionario propio preparado", function () {
    expect(res.getStatus()).to.equal(201);
    expect(res.getBody().id).to.be.a("number").above(0);
    bru.setVar("concesionarioValidacionId", res.getBody().id);
  });
}
