meta {
  name: V07 - Precio negativo
  type: http
  seq: 7
}
put {
  url: {{baseUrl}}/api/vehiculo/{{vehiculoValidacionId}}
  body: multipartForm
  auth: bearer
}
auth:bearer {
  token: {{trabajadorToken}}
}
body:multipart-form {
  foto: @file(fixtures/vehiculo.jpg)
  matricula: {{matriculaValidacion}}
  marca: {{marcaValidacion}}
  modelo: Modelo validacion
  acriss: ILAH
  color: Negro
  precioBaseDia: -1
  plazas: 5
  maleteroLitros: 470
  autonomiaKm: 900
  kilometraje: 1500
  fechaUltimaRevision: 2026-01-15
  concesionario: {{concesionarioValidacionId}}
}
tests {
  // Assert
  test("Precio negativo rechazado por PrecioBaseDia", function () {
    expect(res.getStatus()).to.equal(400);
    expect(res.getBody().details.PrecioBaseDia).to.include("El precio base por día debe ser mayor que cero.");
  });
}
