meta {
  name: [020] OFICINA - Actualizar como Responsable (200)
  type: http
  seq: 4
}

put {
  url: {{baseUrl}}/api/oficina
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{responsableToken}}
}

body:json {
  {
    "nombre": "Oficina Central Leganés",
    "direccion": "Avenida de la Universidad 1, 28911 Leganés, Madrid",
    "telefono": "+34 916 000 111",
    "email": "oficina@alquiler.local",
    "diaInicio": 1,
    "diaFin": 5,
    "horaApertura": "09:00:00",
    "horaCierre": "20:00:00"
  }
}

script:post-response {
  test("Actualizar oficina como Responsable - Status 200 OK", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("Actualizar oficina - Devuelve horario formateado", function () {
    const body = res.getBody();
    expect(body.horarioFormateado).to.equal("Lunes a Viernes de 09:00 a 20:00");
  });
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  RF-11 / RF-46: el Responsable de oficina puede actualizar datos y horario.
}
