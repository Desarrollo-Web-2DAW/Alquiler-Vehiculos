meta {
  name: [134] HISTORICO - Consultar vehiculo retirado como Admin (200)
  type: http
  seq: 15
}
get {
  url: {{baseUrl}}/api/vehiculo/{{vehiculoHistoricoId}}
  body: none
  auth: bearer
}
auth:bearer {
  token: {{adminToken}}
}
tests {
  // Assert
  test("RF-01 y RF-48: vehículo retirado conserva identidad, relaciones y foto", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().id).to.equal(bru.getVar("vehiculoHistoricoId"));
    expect(res.getBody().estado).to.equal("Retirado");
    expect(res.getBody().isActivo).to.equal(false);
    expect(res.getBody().marca).to.equal(bru.getVar("marcaHistoricoNombre"));
    expect(res.getBody().concesionario).to.equal(bru.getVar("concesionarioHistoricoId"));
    expect(res.getBody().foto).to.equal(bru.getVar("fotoActualHistorico"));
  });
}
