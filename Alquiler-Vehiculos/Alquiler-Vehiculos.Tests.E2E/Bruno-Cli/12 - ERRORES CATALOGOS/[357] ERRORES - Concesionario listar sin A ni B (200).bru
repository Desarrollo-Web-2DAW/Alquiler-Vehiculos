meta {
  name: [357] ERRORES - Concesionario listar sin A ni B (200)
  type: http
  seq: 57
}

get {
  url: {{baseUrl}}/api/concesionario
  body: none
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

tests {
  test("Los retirados no aparecen en el listado", function () {
    expect(res.getStatus()).to.equal(200);
    const ids = res.getBody().map(c => c.id);
    expect(ids).to.not.include(bru.getVar("errConcAId"));
    expect(ids).to.not.include(bru.getVar("errConcBId"));
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
