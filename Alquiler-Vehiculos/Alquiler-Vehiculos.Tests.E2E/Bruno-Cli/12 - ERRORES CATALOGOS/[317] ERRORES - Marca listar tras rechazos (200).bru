meta {
  name: [317] ERRORES - Marca listar tras rechazos (200)
  type: http
  seq: 17
}

get {
  url: {{baseUrl}}/api/marca
  body: none
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

tests {
  test("La base de datos no recibió los PUT rechazados", function () {
    expect(res.getStatus()).to.equal(200);
    const m = res.getBody().find(x => x.id === bru.getVar("errMarcaId"));
    expect(m).to.not.be.undefined;
    expect(m.nombre).to.equal(bru.getVar("errMarcaNombre"));
    expect(m.modelosDisponibles).to.deep.equal(["Modelo A"]);
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
