}

tests {
  test("Los rechazos no crean concesionarios", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().filter(c => c.nombre === bru.getVar("errRechazada"))).to.be.empty;
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
