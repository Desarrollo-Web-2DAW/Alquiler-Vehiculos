meta {
  name: [313] ERRORES - Marca modificar con lista de modelos vacia (400)
  type: http
  seq: 13
}

put {
  url: {{baseUrl}}/api/marca/{{errMarcaId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

body:json {
  { "nombre": "No debe guardarse", "pais": "Francia", "web": "https://otra.example", "modelosDisponibles": [] }
}

tests {
  test("RF-09: modificación rechazada (con lista de modelos vacia)", function () {
    expect(res.getStatus()).to.equal(400);
    const body = res.getBody();
    const campos = body.details || body.errors;
    expect(campos, "el 400 debe indicar los campos").to.be.an("object");
    expect(campos).to.have.property("ModelosDisponibles");
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
