meta {
  name: [335] ERRORES - Concesionario alta telefono que empieza por 5 (400)
  type: http
  seq: 35
}

post {
  url: {{baseUrl}}/api/concesionario
  body: json
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

body:json {
  { "nombre": "{{errRechazada}}", "ciudad": "Madrid", "telefono": "500000001", "email": "errores@concesionario.example" }
}

tests {
  test("RF-10: alta rechazada (telefono que empieza por 5)", function () {
    expect(res.getStatus()).to.equal(400);
    const body = res.getBody();
    const campos = body.details || body.errors;
    expect(campos, "el 400 debe indicar los campos").to.be.an("object");
    expect(campos).to.have.property("Telefono");
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
