meta {
  name: [341] ERRORES - Concesionario modificar A sin nombre (400)
  type: http
  seq: 41
}

put {
  url: {{baseUrl}}/api/concesionario/{{errConcAId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

body:json {
  { "nombre": "", "ciudad": "Madrid", "telefono": "{{errTelA}}", "email": "errores@concesionario.example" }
}

tests {
  test("RF-10: modificación rechazada (sin nombre)", function () {
    expect(res.getStatus()).to.equal(400);
    const body = res.getBody();
    const campos = body.details || body.errors;
    expect(campos, "el 400 debe indicar los campos").to.be.an("object");
    expect(campos).to.have.property("Nombre");
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
