meta {
  name: [355] ERRORES - Concesionario modificar A con telefono de B retirado (409)
  type: http
  seq: 55
}

put {
  url: {{baseUrl}}/api/concesionario/{{errConcAId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

body:json {
  { "nombre": "No debe guardarse", "ciudad": "Madrid", "telefono": "{{errTelB}}", "email": "errores@concesionario.example" }
}

tests {
  test("El teléfono de un concesionario retirado sigue reservado", function () {
    expect(res.getStatus()).to.equal(409);
    expect(res.getBody().code).to.equal("TELEFONO_CONCESIONARIO_DUPLICADO");
  });
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  Decisión vigente del proyecto: ExistsByTelefono incluye el histórico (bajas lógicas).
}
