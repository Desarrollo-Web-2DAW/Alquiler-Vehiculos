meta {
  name: [309] ERRORES - Marca alta lista de modelos vacia (400)
  type: http
  seq: 9
}

post {
  url: {{baseUrl}}/api/marca
  body: json
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

body:json {
  { "nombre": "{{errRechazada}}", "pais": "España", "web": "https://errores.example", "modelosDisponibles": [] }
}

tests {
  test("RF-09: alta rechazada (lista de modelos vacia)", function () {
    expect(res.getStatus()).to.equal(400);
    const body = res.getBody();
    const campos = body.details || body.errors;
    expect(campos, "el 400 debe indicar los campos").to.be.an("object");
    expect(campos).to.have.property("ModelosDisponibles");
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
