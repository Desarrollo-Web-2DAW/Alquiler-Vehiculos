meta {
  name: [332] ERRORES - Concesionario alta nombre de 101 caracteres (400)
  type: http
  seq: 32
}

post {
  url: {{baseUrl}}/api/concesionario
  body: json
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

body:json {
  { "nombre": "{{texto101}}", "ciudad": "Madrid", "telefono": "600000001", "email": "errores@concesionario.example" }
}

tests {
  test("RF-10: alta rechazada (nombre de 101 caracteres)", function () {
    expect(res.getStatus()).to.equal(400);
    const body = res.getBody();
    const campos = body.details || body.errors;
    expect(campos, "el 400 debe indicar los campos").to.be.an("object");
    expect(campos).to.have.property("Nombre");
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
