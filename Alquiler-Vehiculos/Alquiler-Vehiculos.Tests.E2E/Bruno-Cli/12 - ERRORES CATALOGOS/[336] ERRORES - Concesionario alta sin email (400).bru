meta {
  name: [336] ERRORES - Concesionario alta sin email (400)
  type: http
  seq: 36
}

post {
  url: {{baseUrl}}/api/concesionario
  body: json
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

body:json {
  { "nombre": "{{errRechazada}}", "ciudad": "Madrid", "telefono": "600000001", "email": "" }
}

tests {
  test("RF-10: alta rechazada (sin email)", function () {
    expect(res.getStatus()).to.equal(400);
    const body = res.getBody();
    const campos = body.details || body.errors;
    expect(campos, "el 400 debe indicar los campos").to.be.an("object");
    expect(campos).to.have.property("Email");
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
