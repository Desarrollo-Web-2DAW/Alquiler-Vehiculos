meta {
  name: [342] ERRORES - Concesionario modificar A con telefono mal formado (400)
  type: http
  seq: 42
}

put {
  url: {{baseUrl}}/api/concesionario/{{errConcAId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

body:json {
  { "nombre": "No debe guardarse", "ciudad": "Madrid", "telefono": "12345", "email": "errores@concesionario.example" }
}

tests {
  test("RF-10: modificación rechazada (con telefono mal formado)", function () {
    expect(res.getStatus()).to.equal(400);
    const body = res.getBody();
    const campos = body.details || body.errors;
    expect(campos, "el 400 debe indicar los campos").to.be.an("object");
    expect(campos).to.have.property("Telefono");
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
