meta {
  name: [314] ERRORES - Marca modificar sin nombre (400)
  type: http
  seq: 14
}

put {
  url: {{baseUrl}}/api/marca/{{errMarcaId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

body:json {
  { "nombre": "", "pais": "Francia", "web": "https://otra.example", "modelosDisponibles": ["Otro"] }
}

tests {
  test("RF-09: modificación rechazada (sin nombre)", function () {
    expect(res.getStatus()).to.equal(400);
    const body = res.getBody();
    const campos = body.details || body.errors;
    expect(campos, "el 400 debe indicar los campos").to.be.an("object");
    expect(campos).to.have.property("Nombre");
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
