meta {
  name: [343] ERRORES - Concesionario modificar A con ciudad de 101 caracteres (400)
  type: http
  seq: 43
}

put {
  url: {{baseUrl}}/api/concesionario/{{errConcAId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

body:json {
  { "nombre": "No debe guardarse", "ciudad": "{{texto101}}", "telefono": "{{errTelA}}", "email": "errores@concesionario.example" }
}

tests {
  test("RF-10: modificación rechazada (con ciudad de 101 caracteres)", function () {
    expect(res.getStatus()).to.equal(400);
    const body = res.getBody();
    const campos = body.details || body.errors;
    expect(campos, "el 400 debe indicar los campos").to.be.an("object");
    expect(campos).to.have.property("Ciudad");
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
