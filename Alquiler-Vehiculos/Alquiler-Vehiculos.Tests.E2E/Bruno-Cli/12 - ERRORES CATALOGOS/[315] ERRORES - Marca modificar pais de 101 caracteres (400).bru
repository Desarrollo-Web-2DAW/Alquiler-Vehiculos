meta {
  name: [315] ERRORES - Marca modificar pais de 101 caracteres (400)
  type: http
  seq: 15
}

put {
  url: {{baseUrl}}/api/marca/{{errMarcaId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

body:json {
  { "nombre": "No debe guardarse", "pais": "{{texto101}}", "web": "https://otra.example", "modelosDisponibles": ["Otro"] }
}

tests {
  test("RF-09: modificación rechazada (pais de 101 caracteres)", function () {
    expect(res.getStatus()).to.equal(400);
    const body = res.getBody();
    const campos = body.details || body.errors;
    expect(campos, "el 400 debe indicar los campos").to.be.an("object");
    expect(campos).to.have.property("Pais");
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
