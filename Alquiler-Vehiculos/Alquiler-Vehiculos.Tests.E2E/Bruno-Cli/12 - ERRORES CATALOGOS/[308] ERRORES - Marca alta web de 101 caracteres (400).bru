meta {
  name: [308] ERRORES - Marca alta web de 101 caracteres (400)
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/api/marca
  body: json
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

body:json {
  { "nombre": "{{errRechazada}}", "pais": "España", "web": "{{texto101}}", "modelosDisponibles": ["Modelo A"] }
}

tests {
  test("RF-09: alta rechazada (web de 101 caracteres)", function () {
    expect(res.getStatus()).to.equal(400);
    const body = res.getBody();
    const campos = body.details || body.errors;
    expect(campos, "el 400 debe indicar los campos").to.be.an("object");
    expect(campos).to.have.property("Web");
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
