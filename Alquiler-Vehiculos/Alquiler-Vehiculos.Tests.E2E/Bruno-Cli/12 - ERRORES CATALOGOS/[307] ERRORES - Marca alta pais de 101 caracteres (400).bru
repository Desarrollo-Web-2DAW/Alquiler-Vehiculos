meta {
  name: [307] ERRORES - Marca alta pais de 101 caracteres (400)
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/api/marca
  body: json
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

body:json {
  { "nombre": "{{errRechazada}}", "pais": "{{texto101}}", "web": "https://errores.example", "modelosDisponibles": ["Modelo A"] }
}

tests {
  test("RF-09: alta rechazada (pais de 101 caracteres)", function () {
    expect(res.getStatus()).to.equal(400);
    const body = res.getBody();
    const campos = body.details || body.errors;
    expect(campos, "el 400 debe indicar los campos").to.be.an("object");
    expect(campos).to.have.property("Pais");
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
