meta {
  name: [310] ERRORES - Marca alta con un modelo en blanco (400)
  type: http
  seq: 10
}

post {
  url: {{baseUrl}}/api/marca
  body: json
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

body:json {
  { "nombre": "{{errRechazada}}", "pais": "España", "web": "https://errores.example", "modelosDisponibles": ["Modelo A", "  "] }
}

tests {
  test("RF-09: alta rechazada (con un modelo en blanco)", function () {
    expect(res.getStatus()).to.equal(400);
    const body = res.getBody();
    const campos = body.details || body.errors;
    expect(campos, "el 400 debe indicar los campos").to.be.an("object");
    expect(campos).to.have.property("ModelosDisponibles[1]");
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
