meta {
  name: [316] ERRORES - Marca consultar tras rechazos (200)
  type: http
  seq: 16
}

get {
  url: {{baseUrl}}/api/marca/{{errMarcaId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

tests {
  test("La caché sigue devolviendo los datos vigentes, no un intento rechazado", function () {
    expect(res.getStatus()).to.equal(200);
    const m = res.getBody();
    expect(m.nombre).to.equal(bru.getVar("errMarcaNombre"));
    expect(m.pais).to.equal("España");
    expect(m.web).to.equal("https://errores.example");
    expect(m.modelosDisponibles).to.deep.equal(["Modelo A"]);
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
