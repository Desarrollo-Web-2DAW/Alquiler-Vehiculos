meta {
  name: [346] ERRORES - Concesionario consultar A tras modificar (200)
  type: http
  seq: 46
}

get {
  url: {{baseUrl}}/api/concesionario/{{errConcAId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

tests {
  test("La caché se invalidó tras el PUT válido", function () {
    expect(res.getStatus()).to.equal(200);
    const c = res.getBody();
    expect(c.nombre).to.equal(bru.getVar("errConcANuevo"));
    expect(c.ciudad).to.equal("Madrid");
    expect(c.telefono).to.equal(bru.getVar("errTelA"));
    expect(c.email).to.equal("errores@concesionario.example");
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
