meta {
  name: [114] CONCESIONARIOS - Modificar como Admin (200)
  type: http
  seq: 9
}

put {
  url: {{baseUrl}}/api/concesionario/{{concesionarioE2EId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

body:json {
  { "nombre": "{{concesionarioNombreE2E}} actualizado", "ciudad": "Leganés", "telefono": "{{concesionarioTelefonoE2E}}", "email": "nuevo@concesionario.example" }
}

tests {
  // Assert
  test("RF-10: modifica datos manteniendo ID y su propio teléfono", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().id).to.equal(bru.getVar("concesionarioE2EId"));
    expect(res.getBody().nombre).to.equal(`${bru.getVar("concesionarioNombreE2E")} actualizado`);
    expect(res.getBody().ciudad).to.equal("Leganés");
    expect(res.getBody().telefono).to.equal(bru.getVar("concesionarioTelefonoE2E"));
    expect(res.getBody().email).to.equal("nuevo@concesionario.example");
  });
}
