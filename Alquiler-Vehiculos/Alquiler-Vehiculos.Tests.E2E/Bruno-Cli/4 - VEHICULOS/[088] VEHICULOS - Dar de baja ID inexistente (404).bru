meta {
  name: [088] VEHICULOS - Dar de baja ID inexistente (404)
  type: http
  seq: 67
}

delete {
  url: {{baseUrl}}/api/vehiculo/noExiste000
  body: none
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

script:post-response {
  test("Dar de baja ID inexistente - Status 404", function () {
    expect(res.getStatus()).to.equal(404);
  });

  test("Dar de baja ID inexistente - Código VEHICULO_NO_ENCONTRADO", function () {
    expect(res.getBody().code).to.equal("VEHICULO_NO_ENCONTRADO");
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
