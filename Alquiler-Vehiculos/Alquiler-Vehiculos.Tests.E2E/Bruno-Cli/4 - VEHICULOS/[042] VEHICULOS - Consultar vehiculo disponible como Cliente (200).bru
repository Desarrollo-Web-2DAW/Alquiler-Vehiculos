meta {
  name: [042] VEHICULOS - Consultar vehiculo disponible como Cliente (200)
  type: http
  seq: 21
}

get {
  url: {{baseUrl}}/api/vehiculo/{{vehiculoDisponibleId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{clienteToken}}
}

script:post-response {
  test("Consultar vehiculo disponible como Cliente - Status 200", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("Consultar vehiculo disponible como Cliente - Contenido de la respuesta", function () {
    expect(res.getBody().estado).to.equal("Disponible");
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
