meta {
  name: [091] VEHICULOS - Restaurar vehiculo en alquiler (409)
  type: http
  seq: 70
}

patch {
  url: {{baseUrl}}/api/vehiculo/{{vehiculoEnAlquilerId}}/restore
  body: none
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

tests {
  test("Restaurar vehiculo en alquiler - Status 409", function () {
    expect(res.getStatus()).to.equal(409);
  });

  test("Restaurar vehiculo en alquiler - Código VEHICULO_NO_RETIRADO", function () {
    expect(res.getBody().code).to.equal("VEHICULO_NO_RETIRADO");
  });
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  RF-05: solo se restaura una unidad retirada. Una unidad en alquiler no se libera.
}
