meta {
  name: [076] VEHICULOS - Crear sin foto (400)
  type: http
  seq: 55
}

post {
  url: {{baseUrl}}/api/vehiculo
  body: multipartForm
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

body:multipart-form {
  matricula: {{matriculaAleatoria}}
  marca: Toyota
  modelo: Corolla Sedán
  acriss: ILAH
  color: Blanco
  precioBaseDia: 55
  plazas: 5
  maleteroLitros: 470
  autonomiaKm: 900
  kilometraje: 1000
  fechaUltimaRevision: 2026-01-15
  concesionario: {{concesionarioId}}
}

script:pre-request {
  const letras = "BCDFGHJKLMNPRSTVWXYZ";
  const n = String(Math.floor(Math.random() * 10000)).padStart(4, "0");
  const l = Array.from({ length: 3 }, () => letras[Math.floor(Math.random() * letras.length)]).join("");
  bru.setVar("matriculaAleatoria", n + l);
}

tests {
  test("Crear sin foto - Status 400", function () {
    expect(res.getStatus()).to.equal(400);
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
