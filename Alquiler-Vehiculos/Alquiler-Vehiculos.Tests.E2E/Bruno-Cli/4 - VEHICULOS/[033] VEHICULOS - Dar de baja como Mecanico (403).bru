meta {
  name: [033] VEHICULOS - Dar de baja como Mecanico (403)
  type: http
  seq: 12
}

delete {
  url: {{baseUrl}}/api/vehiculo/noExiste000
  body: none
  auth: bearer
}

auth:bearer {
  token: {{mecanicoToken}}
}

tests {
  test("Dar de baja como Mecanico - Status 403", function () {
    expect(res.getStatus()).to.equal(403);
  });
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  La política se evalúa antes de buscar el vehículo: se usa un ID inexistente para no tocar datos.
}
