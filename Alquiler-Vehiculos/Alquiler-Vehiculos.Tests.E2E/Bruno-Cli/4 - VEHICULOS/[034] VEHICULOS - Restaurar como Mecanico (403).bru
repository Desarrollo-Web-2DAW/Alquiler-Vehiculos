meta {
  name: [034] VEHICULOS - Restaurar como Mecanico (403)
  type: http
  seq: 13
}

patch {
  url: {{baseUrl}}/api/vehiculo/noExiste000/restore
  body: none
  auth: bearer
}

auth:bearer {
  token: {{mecanicoToken}}
}

script:post-response {
  test("Restaurar como Mecanico - Status 403", function () {
    expect(res.getStatus()).to.equal(403);
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
