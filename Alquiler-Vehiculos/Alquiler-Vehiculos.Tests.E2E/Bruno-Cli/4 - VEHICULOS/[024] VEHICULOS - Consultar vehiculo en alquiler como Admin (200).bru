meta {
  name: [024] VEHICULOS - Consultar vehiculo en alquiler como Admin (200)
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/vehiculo/{{vehiculoEnAlquilerId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

script:post-response {
  test("Consultar vehiculo en alquiler como Admin - Status 200", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("Consultar vehiculo en alquiler como Admin - Contenido de la respuesta", function () {
    expect(res.getBody().estado).to.equal("EnAlquiler");
  });
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  RF-46: el personal ve cualquier unidad, aunque no esté Disponible.
}
