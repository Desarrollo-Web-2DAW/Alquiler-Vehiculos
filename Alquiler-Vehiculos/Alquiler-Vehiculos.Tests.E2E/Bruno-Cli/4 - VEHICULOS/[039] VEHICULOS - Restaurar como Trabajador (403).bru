meta {
  name: [039] VEHICULOS - Restaurar como Trabajador (403)
  type: http
  seq: 18
}

patch {
  url: {{baseUrl}}/api/vehiculo/noExiste000/restore
  body: none
  auth: bearer
}

auth:bearer {
  token: {{trabajadorToken}}
}

script:post-response {
  test("Restaurar como Trabajador - Status 403", function () {
    expect(res.getStatus()).to.equal(403);
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
