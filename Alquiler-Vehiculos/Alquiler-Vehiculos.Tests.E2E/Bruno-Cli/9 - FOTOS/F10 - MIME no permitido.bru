meta {
  name: F10 - MIME no permitido
  type: http
  seq: 10
}
post {
  url: {{baseUrl}}/api/fotos
  body: text
  auth: bearer
}
auth:bearer {
  token: {{adminToken}}
}
script:pre-request {
  // Arrange: extensión permitida para aislar únicamente el MIME.
  req.setHeader("Content-Type", "multipart/form-data; boundary=bruno-foto");
  req.setBody('--bruno-foto\r\nContent-Disposition: form-data; name="archivo"; filename="rechazada.jpg"\r\nContent-Type: text/plain\r\n\r\nx\r\n--bruno-foto--\r\n');
}
tests {
  // Assert
  test("422 con TIPO_CONTENIDO_NO_PERMITIDO", function () {
    expect(res.getStatus()).to.equal(422);
    expect(res.getBody().code).to.equal("TIPO_CONTENIDO_NO_PERMITIDO");
  });
}
