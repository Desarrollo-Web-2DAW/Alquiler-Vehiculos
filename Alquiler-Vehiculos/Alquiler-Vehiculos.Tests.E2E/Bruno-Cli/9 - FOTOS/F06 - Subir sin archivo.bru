meta {
  name: F06 - Subir sin archivo
  type: http
  seq: 6
}
post {
  url: {{baseUrl}}/api/fotos
  body: multipartForm
  auth: bearer
}
auth:bearer {
  token: {{adminToken}}
}
body:multipart-form {
  descripcion: falta archivo
}
tests {
  // Assert
  test("400 por el campo archivo ausente", function () {
    expect(res.getStatus()).to.equal(400);
    expect(res.getBody().details.archivo).to.include("Debe proporcionar una imagen con contenido.");
  });
}
