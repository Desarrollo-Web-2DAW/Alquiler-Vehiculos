meta {
  name: F34 - Historico Trabajador
  type: http
  seq: 34
}
get {
  url: {{baseUrl}}/api/fotos/historico/{{fotoIndependiente}}
  body: none
  auth: bearer
}
auth:bearer {
  token: {{trabajadorToken}}
}
tests {
  // Assert
  test("Trabajador consulta histórico", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().nombre).to.equal(bru.getVar("fotoIndependiente"));
    expect(res.getBody().activo).to.equal(false);
  });
}
