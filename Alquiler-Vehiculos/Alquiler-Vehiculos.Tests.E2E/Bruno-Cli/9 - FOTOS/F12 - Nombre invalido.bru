meta {
  name: F12 - Nombre invalido
  type: http
  seq: 12
}
get {
  url: {{baseUrl}}/api/fotos/invalida..jpg
  body: none
  auth: none
}
tests {
  // Assert
  test("400 de validación, no búsqueda ni error de servidor", function () {
    expect(res.getStatus()).to.equal(400);
    expect(res.getBody().message).to.equal("El identificador debe ser un nombre de foto, no una ruta.");
  });
}
