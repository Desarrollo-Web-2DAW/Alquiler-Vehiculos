meta {
  name: F17 - Descargar historico como Mecanico
  type: http
  seq: 17
}
get {
  url: {{baseUrl}}/api/fotos/historico/{{fotoIndependiente}}/archivo
  body: none
  auth: bearer
}
auth:bearer {
  token: {{mecanicoToken}}
}
tests {
  // Assert
  test("Mecánico descarga bytes conservados", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getHeader("content-type")).to.include("image/jpeg");
    expect(Number(res.getHeader("content-length"))).to.equal(bru.getVar("metadatosIndependiente").tamano);
  });
}
