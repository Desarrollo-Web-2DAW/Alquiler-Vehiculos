meta {
  name: F16 - Historico como Responsable
  type: http
  seq: 16
}
get {
  url: {{baseUrl}}/api/fotos/historico/{{fotoIndependiente}}
  body: none
  auth: bearer
}
auth:bearer {
  token: {{responsableToken}}
}
tests {
  // Assert
  test("Responsable consulta la baja conservada", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().nombre).to.equal(bru.getVar("fotoIndependiente"));
    expect(res.getBody().activo).to.equal(false);
    expect(res.getBody().deletedAt).to.be.a("string");
  });
}
