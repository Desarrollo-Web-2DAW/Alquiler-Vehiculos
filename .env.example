# ============================================
# CONFIGURACIÓN DE ALQUILER-VEHICULOS API (Docker Compose)
# ============================================
# Copia este archivo a .env y sustituye los valores necesarios.
# Nunca subas .env al repositorio (RNF-03).
# ============================================

# Entorno y puerto expuesto de la API
ASPNETCORE_ENVIRONMENT=Development
API_PORT=8080
BUILD_CONFIGURATION=Release

# PostgreSQL
POSTGRES_DB=alquiler
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5433

# Redis
REDIS_PORT=6379

# JWT (mínimo 32 caracteres / 256 bits)
JWT_KEY=CAMBIAR_POR_CLAVE_SEGURA_MINIMO_32_CARACTERES

# Correo (por defecto apunta al contenedor Mailpit en desarrollo)
EMAIL_HOST=mailpit
EMAIL_PORT=1025
EMAIL_SECURITY=None
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_FROM=no-reply@alquilervehiculos.local
EMAIL_USE_SMTP=true
